{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "H#",
  "scopeName": "source.hsharp",
  "fileTypes": ["hs"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#declaration-types" },
    { "include": "#runtime-types" },
    { "include": "#builtins" },
    { "include": "#static-classes" },
    { "include": "#type-declarations" },
    { "include": "#function-decl" },
    { "include": "#generic-args" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.hsharp",
          "match": "//.*$"
        },
        {
          "name": "comment.block.hsharp",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.interpolated.hsharp",
          "begin": "\\$\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.hsharp",
              "match": "\\\\."
            },
            {
              "name": "meta.embedded.expression.hsharp",
              "begin": "(?<!\\{)\\{(?!\\{)",
              "end": "(?<!\\})\\}(?!\\})",
              "patterns": [
                { "include": "#keywords" },
                { "include": "#declaration-types" },
                { "include": "#runtime-types" },
                { "include": "#builtins" },
                { "include": "#static-classes" },
                { "include": "#constants" },
                { "include": "#numbers" },
                { "include": "#operators" },
                { "include": "#identifiers" }
              ]
            },
            {
              "name": "constant.character.escape.hsharp",
              "match": "\\{\\{|\\}\\}"
            }
          ]
        },
        {
          "name": "string.quoted.double.hsharp",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.hsharp",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.hsharp",
          "match": "\\b(if|else|while|for|foreach|in|return|try|catch|break|continue|await|lock|switch|case|default)\\b"
        },
        {
          "name": "keyword.declaration.hsharp",
          "match": "\\b(var|import|move|new)\\b"
        },
        {
          "name": "storage.modifier.hsharp",
          "match": "\\b(public)\\b"
        }
      ]
    },
    "declaration-types": {
      "patterns": [
        {
          "name": "storage.type.class.hsharp",
          "match": "\\b(class|struct|enum)\\b"
        },
        {
          "name": "storage.type.primitive.hsharp",
          "match": "\\b(int|float|bool|string|void)\\b"
        },
        {
          "name": "storage.type.generic.hsharp",
          "match": "\\b(list|map|task|buffer)\\b"
        }
      ]
    },
    "runtime-types": {
      "patterns": [
        {
          "name": "support.class.hsharp",
          "match": "\\b(Task|Tcp|Udp|Http|StringBuilder)\\b"
        },
        {
          "name": "entity.name.type.handle.hsharp",
          "match": "\\b(Client|HttpPacket|RawHttpPacket|listener|httpl|rawhttpl)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.hsharp",
          "match": "\\b(print|input|len|copy|read|write|exists|delete|mem|clock_ms|lastError|args|env|exiting|buffer)\\b"
        }
      ]
    },
    "static-classes": {
      "patterns": [
        {
          "match": "\\b(Task|Tcp|Udp|Http|StringBuilder)(\\.)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "support.class.hsharp" },
            "2": { "name": "punctuation.accessor.hsharp" },
            "3": { "name": "entity.name.function.hsharp" }
          }
        }
      ]
    },
    "type-declarations": {
      "patterns": [
        {
          "match": "\\b(class|struct|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "storage.type.class.hsharp" },
            "2": { "name": "entity.name.type.hsharp" }
          }
        }
      ]
    },
    "function-decl": {
      "patterns": [
        {
          "match": "\\b(int|float|bool|string|void|list|buffer|map|task|[A-Za-z_][A-Za-z0-9_]*)\\??\\s*(<[A-Za-z0-9_,<>\\s\\?]+>)?\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(<[A-Za-z0-9_,<>\\s]+>)?\\s*(?=\\()",
          "captures": {
            "1": { "name": "storage.type.hsharp" },
            "2": { "name": "storage.type.generic.hsharp" },
            "3": { "name": "entity.name.function.hsharp" },
            "4": { "name": "storage.type.generic.hsharp" }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(<[A-Za-z0-9_,\\s]+>)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.hsharp" },
            "2": { "name": "storage.type.generic.hsharp" }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.hsharp" }
          }
        }
      ]
    },
    "generic-args": {
      "patterns": [
        {
          "match": "\\b(list|map|task)\\s*<(?:[A-Za-z0-9_,<>\\s\\?]*?)>",
          "captures": {
            "1": { "name": "storage.type.generic.hsharp" }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.hsharp",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.hsharp",
          "match": "\\bnull\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.hsharp",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.hsharp",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.null-coalescing.hsharp",
          "match": "\\?\\?"
        },
        {
          "name": "keyword.operator.null-conditional.hsharp",
          "match": "\\?\\."
        },
        {
          "name": "keyword.operator.ternary.hsharp",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.assignment.hsharp",
          "match": "=>"
        },
        {
          "name": "keyword.operator.arithmetic.hsharp",
          "match": "\\+\\+|--|\\+=|-=|\\*=|/=|%=|\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.comparison.hsharp",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.hsharp",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.hsharp",
          "match": "(?<![=!<>])=(?!=)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.hsharp",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.hsharp",
          "match": ","
        },
        {
          "name": "punctuation.accessor.hsharp",
          "match": "\\.|\\?\\."
        },
        {
          "name": "punctuation.separator.colon.hsharp",
          "match": ":"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.type.hsharp",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        },
        {
          "name": "variable.other.hsharp",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
