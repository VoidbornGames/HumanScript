

define loopInCounter as 1;
define loopOut as 0;
define result as "Result: ";
define loopOutText as " ";

repeat loopInCounter times:
[
    print loopInCounter;
    add 1 to loopInCounter;
    add 1 to loopOut;

    if loopInCounter is greater than 10:
    [
        set loopInCounter to 1;
    ]
]

turn loopOut to text as loopOutText;
set result to result combined with loopOutText;

print result;